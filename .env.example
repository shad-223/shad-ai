# Copy to .env on the VPS. Never commit the real .env.
SHAD_MASTER_PASSWORD_HASH=   # output of: python gen_password_hash.py 'your password'
SHAD_VAULT_SECRET=           # output of: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHAD_DB_PATH=/data/shad.db
SHAD_ACTIVE_ENV_PATH=/data/active.env
